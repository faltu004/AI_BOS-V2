{
  "name": "ai-bos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["frontend", "admin", "ceo", "shared"],
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:dev:server": "npm --prefix frontend run dev:server",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "frontend:lint": "npm --prefix frontend run lint",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "admin:preview": "npm --prefix admin run preview",
    "admin:lint": "npm --prefix admin run lint",
    "ceo:dev": "npm --prefix ceo run dev",
    "ceo:build": "npm --prefix ceo run build",
    "ceo:preview": "npm --prefix ceo run preview",
    "ceo:lint": "npm --prefix ceo run lint",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend start",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:seed": "npm --prefix backend run seed",
    "test:frontend": "node --import ./backend/node_modules/tsx/dist/esm/index.mjs --test \"tests/frontend/**/*.test.ts\"",
    "test:backend": "node --import ./backend/node_modules/tsx/dist/esm/index.mjs --test \"tests/backend/**/*.test.ts\"",
    "test:e2e": "node --import ./backend/node_modules/tsx/dist/esm/index.mjs --test \"tests/e2e/**/*.test.ts\"",
    "test:js": "node --import ./backend/node_modules/tsx/dist/esm/index.mjs --test \"tests/**/*.test.ts\"",
    "coverage:js": "node --experimental-test-coverage --import ./backend/node_modules/tsx/dist/esm/index.mjs --test \"tests/frontend/**/*.test.ts\" \"tests/backend/**/*.test.ts\"",
    "coverage:e2e": "node --experimental-test-coverage --import ./backend/node_modules/tsx/dist/esm/index.mjs --test \"tests/e2e/**/*.test.ts\"",
    "test": "npm run test:js",
    "coverage": "npm run coverage:js",
    "lint": "npm run frontend:lint && npm run admin:lint && npm run ceo:lint",
    "build": "npm run frontend:build && npm run admin:build && npm run ceo:build && npm run backend:build",
    "dev": "npm run frontend:dev"
  }
}
