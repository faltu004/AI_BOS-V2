NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://127.0.0.1:8080,http://127.0.0.1:8081,http://127.0.0.1:8082
COOKIE_DOMAIN=

MONGODB_URI=mongodb://127.0.0.1:27017/ai_bos

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ENCRYPTION_SECRET=change_this_encryption_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
UPLOAD_MAX_FILE_SIZE_MB=10

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_MS=30000

# If SMTP_HOST is left blank, transactional emails (password reset, etc.)
# are only logged, not delivered. Set all four SMTP_* values below to
# enable real email delivery. Never commit real SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI BOS <notifications@aibos.company>

INTEGRATION_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:5000

# Production file logging. Ignored in development (stdout + pino-pretty is
# used instead). LOG_DIR is relative to the backend process working
# directory unless given as an absolute path.
LOG_DIR=logs
LOG_MAX_FILE_SIZE_MB=20
LOG_MAX_FILES=10
