NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=https://REPLACE_WITH_ADMIN_ORIGIN,https://REPLACE_WITH_EMPLOYEE_ORIGIN
COOKIE_DOMAIN=

MONGODB_URI=mongodb://127.0.0.1:27017/ai_bos

JWT_ACCESS_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_CHARACTER_RANDOM_SECRET
ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
UPLOAD_MAX_FILE_SIZE_MB=10

PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_LIMIT=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_MAX_IDLE_MINUTES=30
MAX_TRUSTED_DEVICES_PER_USER=10
MAX_LOGIN_HISTORY_PER_USER=50
ENABLE_LOGIN_HISTORY=true
ENABLE_TRUSTED_DEVICES=true
ENABLE_2FA=false
ENABLE_SECURITY_DASHBOARD=true

ATTENDANCE_OFFICE_LAT=12.9716
ATTENDANCE_OFFICE_LNG=77.5946
ATTENDANCE_RADIUS_METERS=300

# If SMTP_HOST is left blank, transactional emails (password reset, etc.)
# are only logged, not delivered. Set all four SMTP_* values below to
# enable real email delivery. Never commit real SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI BOS <notifications@aibos.company>

INTEGRATION_OAUTH_REDIRECT_BASE_URL=

# Local AI is intentionally not configured in RC1.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_MS=30000

# Device enrollment/update secrets must be generated during Phase 25 setup.
DEVICE_ENROLLMENT_KEY=REPLACE_DURING_PHASE_25
SERVICE_API_KEY=REPLACE_DURING_PHASE_25_IF_LEGACY_MIGRATION_IS_REQUIRED
# Device authentication migration compatibility
# Fresh production deployments must remain fail-closed.
ALLOW_LEGACY_DEVICE_AUTH=false
ALLOW_LEGACY_ENROLLMENT_FALLBACK=false

# Production file logging. LOG_DIR is relative to the backend process
# working directory unless given as an absolute path (recommended:
# an absolute path outside the deployment/update directory tree,
# e.g. D:\AI-BOS-Server\logs, so log files survive a redeploy).
LOG_DIR=logs
LOG_MAX_FILE_SIZE_MB=20
LOG_MAX_FILES=10
