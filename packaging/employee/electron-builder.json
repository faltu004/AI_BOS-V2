{
    "appId":  "com.aibos.employee",
    "productName":  "AI BOS Employee",
    "copyright":  "Copyright © WorknAi Technologies India Pvt Ltd",
    "artifactName":  "AI-BOS-Employee-Setup-${version}.${ext}",
    "directories":  {
                        "output":  "dist/employee-installer"
                    },
    "files":  [
                  "electron/employee-main.cjs",
                  "electron/preload.cjs",
                  "electron/runtime-security.cjs",
                  "frontend/dist/**/*",
                  "package.json",
                  "!backend/.env",
                  "!**/.env",
                  "!**/.env.*"
              ],
    "extraMetadata":  {
                          "main":  "electron/employee-main.cjs"
                      },
    "publish":  [
                    {
                        "provider":  "generic",
                        "url":  "https://ADMIN-WORKNAI:5443/updates/employee/"
                    }
                ],
    "extraResources":  [
                           {
                               "from":  "packaging/runtime-config/employee-aibos-config.json",
                               "to":  "aibos-config.json"
                           },
                           {
                               "from":  "device-agent/dist",
                               "to":  "device-agent/agent/dist",
                               "filter":  [
                                              "**/*",
                                              "!**/.env",
                                              "!**/.env.*",
                                              "!**/*token*",
                                              "!**/*secret*"
                                          ]
                           },
                           {
                               "from":  "device-agent/package.json",
                               "to":  "device-agent/agent/package.json"
                           },
                           {
                               "from":  "device-agent/package-lock.json",
                               "to":  "device-agent/agent/package-lock.json"
                           },
                           {
                               "from":  "device-agent/node_modules",
                               "to":  "device-agent/agent/node_modules",
                               "filter":  [
                                              "**/*",
                                              "!**/.env",
                                              "!**/.env.*",
                                              "!**/*token*",
                                              "!**/*secret*",
                                              "!**/test/**",
                                              "!**/tests/**"
                                          ]
                           },
                           {
                               "from":  "packaging/runtime/node.exe",
                               "to":  "device-agent/runtime/node.exe"
                           },
                           {
                               "from":  "packaging/windows/session-helper-task.ps1",
                               "to":  "device-agent/install/session-helper-task.ps1"
                           },
                           {
                               "from":  "packaging/windows/session-helper-task-cleanup.ps1",
                               "to":  "device-agent/install/session-helper-task-cleanup.ps1"
                           },
                           {
                               "from":  "packaging/windows/install-device-services.ps1",
                               "to":  "device-agent/install/install-device-services.ps1"
                           },
                           {
                               "from":  "packaging/windows/device-credential-migration.ps1",
                               "to":  "device-agent/install/device-credential-migration.ps1"
                           },
                           {
                               "from":  "packaging/windows/uninstall-device-services.ps1",
                               "to":  "device-agent/install/uninstall-device-services.ps1"
                           },
                           {
                               "from":  "packaging/windows/provisioning",
                               "to":  "device-agent/provisioning",
                               "filter":  [
                                              "*.ps1"
                                          ]
                           },
                           {
                               "from":  "device-agent/service",
                               "to":  "device-agent/service",
                               "filter":  [
                                              "AIBOSDeviceAgent.xml",
                                              "AIBOSDeviceAgent.exe",
                                              "AIBOSDeviceUpdater.xml",
                                              "AIBOSDeviceUpdater.exe"
                                          ]
                           },
                           {
                               "from":  "packaging/windows/session-helper-hidden.vbs",
                               "to":  "device-agent/install/session-helper-hidden.vbs"
                           }
                       ],
    "win":  {
                "target":  "nsis",
                "icon":  "packaging/assets/icons/AI-BOS-Employee.ico",
                "signExecutable":  false
            },
    "nsis":  {
                 "include":  "packaging/employee/installer.nsh",
                 "oneClick":  false,
                 "allowToChangeInstallationDirectory":  true,
                 "createDesktopShortcut":  true,
                 "createStartMenuShortcut":  true,
                 "perMachine":  true,
                 "installerIcon":  "packaging/assets/icons/AI-BOS-Employee.ico",
                 "uninstallerIcon":  "packaging/assets/icons/AI-BOS-Employee.ico",
                 "installerHeader":  "packaging/assets/installer/employee-header.bmp",
                 "installerSidebar":  "packaging/assets/installer/employee-sidebar.bmp",
                 "uninstallerSidebar":  "packaging/assets/installer/employee-sidebar.bmp",
                 "shortcutName":  "AI BOS Employee"
             }
}
