{
    "appId":  "com.aibos.admin",
    "productName":  "AI BOS Admin",
    "copyright":  "Copyright © WorknAI Technology Pvt Ltd",
    "artifactName":  "AI-BOS-Admin-Setup-${version}.${ext}",
    "directories":  {
                        "output":  "dist/admin-installer"
                    },
    "files":  [
                  "electron/admin-main.cjs",
                  "electron/preload.cjs",
                  "electron/runtime-security.cjs",
                  "admin/dist/**/*",
                  "package.json",
                  "!backend/.env",
                  "!**/.env",
                  "!**/.env.*"
              ],
    "extraMetadata":  {
                          "main":  "electron/admin-main.cjs"
                      },
    "extraResources":  [
                           {
                               "from":  "packaging/runtime-config/admin-aibos-config.json",
                               "to":  "aibos-config.json"
                           }
                       ],
    "win":  {
                "target":  "nsis",
                "icon":  "packaging/assets/icons/AI-BOS-Admin.ico",
                "signExecutable":  false
            },
    "nsis":  {
                 "include":  "packaging/admin/installer.nsh",
                 "oneClick":  false,
                 "allowToChangeInstallationDirectory":  true,
                 "createDesktopShortcut":  true,
                 "createStartMenuShortcut":  true,
                 "perMachine":  true,
                 "installerIcon":  "packaging/assets/icons/AI-BOS-Admin.ico",
                 "uninstallerIcon":  "packaging/assets/icons/AI-BOS-Admin.ico",
                 "installerHeader":  "packaging/assets/installer/admin-header.bmp",
                 "installerSidebar":  "packaging/assets/installer/admin-sidebar.bmp",
                 "uninstallerSidebar":  "packaging/assets/installer/admin-sidebar.bmp",
                 "shortcutName":  "AI BOS Admin"
             }
}
