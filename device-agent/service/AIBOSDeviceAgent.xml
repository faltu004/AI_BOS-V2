<service>
  <id>AIBOSDeviceAgent</id>

  <name>AI BOS Device Agent</name>

  <description>
    AI BOS managed device monitoring and command agent.
  </description>

  <executable>%BASE%\..\runtime\node.exe</executable>

  <arguments>--use-system-ca "%BASE%\..\agent\dist\index.js"</arguments>

  <workingdirectory>%BASE%\..\agent</workingdirectory>

  <env name="AGENT_MODE" value="service" />

  <env name="BACKEND_URL" value="https://ADMIN-WORKNAI:5443" />

  <startmode>Automatic</startmode>

  <delayedAutoStart>true</delayedAutoStart>

  <stoptimeout>20 sec</stoptimeout>

  <onfailure action="restart" delay="10 sec" />

  <resetfailure>1 hour</resetfailure>

  <serviceaccount>
    <username>LocalSystem</username>
  </serviceaccount>

  <logpath>%BASE%\logs</logpath>

  <log mode="roll"></log>
</service>
